# Nayose runtime configuration — copy to .env and adjust.
# Documented in docs/OPERATIONS.md and docs/CLOUD.md.

# Data & model artifacts (server-side, never committed)
NAYOSE_DATA_DIR=data/current
NAYOSE_MODELS_DIR=models
NAYOSE_OPERATIONAL_DB=data/operational.sqlite3

# Serving
NAYOSE_DASH_PORT=8000
NAYOSE_TELEMETRY_INTERVAL_SECONDS=1  # status-bar resource refresh cadence
NAYOSE_BIND_HOST=127.0.0.1        # 0.0.0.0 when behind a reverse proxy

# Security (set in any shared/production deployment)
# NAYOSE_AUTH_MODE=local_bearer    # local_bearer or trusted_proxy
# NAYOSE_API_TOKEN=                # legacy all-scope bearer credential
# NAYOSE_REVIEW_TOKEN=             # optional read+review credential
# NAYOSE_ADMIN_TOKEN=              # optional read+review+admin credential
#                                 # the web UI sends Bearer <token> from sessionStorage
#                                 # key "nayose.token" (set by an authenticated wrapper)
# NAYOSE_AUTH_SUBJECT_HEADER=X-Authenticated-User
# NAYOSE_AUTH_SCOPES_HEADER=X-Authenticated-Scopes
#                                 # trusted_proxy requires a reverse proxy to strip and
#                                 # re-add these headers; scopes: read review admin.
# NAYOSE_REVIEWER_DEFAULT=web

# Storage admission
# NAYOSE_STORAGE_RESERVE_RATIO=0.10
# NAYOSE_STORAGE_RESERVE_MINIMUM_BYTES=21474836480
# NAYOSE_STORAGE_WORKSPACE_STALE_SECONDS=120

# Model warmup & debugging
# NAYOSE_WARM_EMBED=1              # preload recommend engine at startup
# NAYOSE_DEBUG_SQL=0

# Training knobs (see docs/OPERATIONS.md)
# NAYOSE_SEED=42
# NAYOSE_MODEL_THREADS=10          # one process; bounded by visible CPUs
# NAYOSE_PROCESS_WORKERS=1
# NAYOSE_NEURAL_BATCH=32
# NAYOSE_DEVICE=mps                # neural execution is MPS-only; no CPU fallback
# NAYOSE_MODEL_FAMILY=f2llm_330m   # fixed production profile
# NAYOSE_PAIR_MODEL=lightgbm       # CPU pair training with aligned OpenMP
# PYTORCH_ENABLE_MPS_FALLBACK=0

# Hugging Face (rate limits / gated models for the retrieval encoder)
# HF_TOKEN=